# ==============================================================================
# PriceWise AI Beauty - Production Environment Configuration Template (Phase 12)
# ==============================================================================
# Use these environment variables when configuring your Render/Railway backend
# and Vercel frontend.
# NEVER commit production keys or credentials to Git repositories.
# ==============================================================================

# Environment Mode (production / development)
ENVIRONMENT=production

# ==============================================================================
# Session Token Signing Secret (Phase 14 Stage 2.5 — REQUIRED in production)
# ==============================================================================
# Session tokens (login/register) are signed with this secret. There is NO
# built-in fallback value: if this variable is missing, the backend refuses to
# start instead of signing tokens with a publicly known secret.
#
# Generate a new value with: python -c "import secrets; print(secrets.token_hex(32))"
#
# ROTATION WARNING: changing AUTH_SECRET_KEY invalidates every previously
# issued session token, so all users must sign in again.
#
# AUTH_SECRET_KEY is the canonical variable. SECRET_KEY (below) is still
# accepted as a legacy alias, but AUTH_SECRET_KEY takes precedence.
AUTH_SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_in_production

# Application Secret Key (MUST be a random 64-character hexadecimal string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_key_in_production

# Production Database (Managed PostgreSQL, e.g. Neon, Supabase, or Render Postgres)
# Format: postgresql://username:password@host:port/database_name?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/pricewise_prod?sslmode=require

# CORS Allowed Origins (Comma-separated list of your production frontend domains)
# Example: https://pricewise-ai.vercel.app,https://yourcustomdomain.com
CORS_ORIGINS=https://pricewise-ai.vercel.app

# Server Port (Render and Railway inject PORT automatically)
PORT=8000
API_HOST=0.0.0.0

# Rate Limiting (Per-minute request cap per client IP)
RATE_LIMIT_PER_MINUTE=120

# Google Gemini API Configuration (Backend Only - Server-Side Only)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=your_production_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Maximum Upload File Size in Bytes (Default: 5 MB)
MAX_UPLOAD_SIZE_BYTES=5242880

# ==============================================================================
# Frontend Environment Variable (Configure in Vercel Project Settings)
# ==============================================================================
# VITE_API_BASE_URL=https://your-backend-app.onrender.com
# ==============================================================================
