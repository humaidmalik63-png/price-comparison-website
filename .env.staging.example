# ==============================================================================
# PriceWise AI — Staging Environment Variables Template (.env.staging)
# ==============================================================================

# Core Application Settings
ENVIRONMENT=staging
APP_NAME="PriceWise AI Beauty (Staging)"
APP_VERSION=1.0.0
DEBUG=false

# PostgreSQL Cloud Staging Database URL
# Example for Neon: postgresql://user:pass@ep-cool-dawn-123456-pooler.ap-south-1.aws.neon.tech/neondb?sslmode=require
# Example for Render: postgres://pricewise:pass@dpg-xxxx-a.frankfurt-postgres.render.com/pricewise_staging
DATABASE_URL=postgresql://pricewise:pricewise_staging_pass@127.0.0.1:5433/pricewise_staging

# ==============================================================================
# Session Token Signing Secret (Phase 14 Stage 2.5 — REQUIRED in staging)
# ==============================================================================
# Session tokens (login/register) are signed with this secret. There is NO
# built-in fallback value: if this variable is missing, the backend refuses to
# start instead of signing tokens with a publicly known secret.
#
# Generate a new value with: python -c "import secrets; print(secrets.token_hex(32))"
#
# ROTATION WARNING: changing AUTH_SECRET_KEY invalidates every previously
# issued session token, so all staging users must sign in again.
#
# AUTH_SECRET_KEY is the canonical variable. SECRET_KEY (below) is still
# accepted as a legacy alias, but AUTH_SECRET_KEY takes precedence.
AUTH_SECRET_KEY=replace_with_64_char_random_hex_staging_secret

# Security & Session Secrets (Generate via: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace_with_64_char_random_hex_staging_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Allowed Origins (Comma-separated)
# Explicitly lists staging frontend domain and local development ports
CORS_ORIGINS=https://pricewise-staging.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Google Gemini Intelligence (Backend-Only, NEVER expose to frontend)
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=replace_with_gemini_api_key

# Rate Limiting & Safety
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_SIZE_BYTES=5242880

# Frontend Environment Variable (Set in Vercel Dashboard for Frontend Project)
# VITE_API_BASE_URL=https://pricewise-backend-staging.onrender.com
# VITE_API_URL=https://pricewise-backend-staging.onrender.com
